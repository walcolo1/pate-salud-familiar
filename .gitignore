# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# A9 · La plantilla SI se versiona: solo nombres y marcadores, ningun valor.
# Sin ella, un clon limpio no sabe que variables necesita.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# ── Credenciales de servicio · NUNCA versionar ────────────────────────────
# La clave de auditoría vive fuera del árbol del repositorio; estas reglas
# son defensa en profundidad por si alguna vez cae una dentro.
.pate-secrets/
*.service-account.json
*service-account*.json

# ── Artefactos de Playwright (A6-F2) ─────────────────────────────────────
# Pueden contener capturas, videos y trazas con datos de sesion: NUNCA se
# versionan. La configuracion los desactiva, esto es la segunda barrera.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.auth/

# ── Restos del emulador de Firebase ──────────────────────────────────────
firestore-debug.log
firebase-debug.log
*-debug.log
.firebase/

# Compilacion secundaria del arnes (sin Client ID)
/.next-sin-config/

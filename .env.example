# Paté · Salud Familiar — plantilla de variables de entorno
#
# Copia este archivo a `.env.local` y rellena los valores para tu entorno.
# `.env.local` NUNCA se versiona: está excluido en .gitignore.
#
# Todas las variables `NEXT_PUBLIC_*` se incrustan en el paquete durante la
# compilación y quedan a la vista de cualquiera que abra la aplicación. Eso
# está bien para identificadores públicos —como el Client ID de OAuth o la
# configuración de Firebase—, pero significa que aquí NO va nunca un secreto:
# ni claves privadas, ni client secrets, ni tokens.

# --- AUTENTICACIÓN CON GOOGLE ---
# Client ID de OAuth 2.0, tipo «Aplicación web», de tu proyecto de Google Cloud.
# Sin este valor la aplicación no inicia sesión y muestra un error de
# configuración: no hay ningún valor de reserva incrustado en el código.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- BACKEND DE DATOS ---
# `firebase` (actual) o `sheets` (capa transitoria).
# El arnés E2E usa `sheets` con credenciales falsas.
NEXT_PUBLIC_DATA_BACKEND=firebase

# --- FIREBASE ---
# Valores de la consola de Firebase → Configuración del proyecto → Tus apps.
# Son identificadores públicos, no secretos.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- CONFIGURACIÓN DE LA APLICACIÓN ---
# Declarada por compatibilidad; hoy no la lee ningún módulo.
NEXT_PUBLIC_APP_URL=http://localhost:3000
